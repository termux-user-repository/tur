Description: Fix linking flags and cross-compilation architecture detection for Android
 On Android (Bionic libc), pthread and rt functionality are part of libc.so,
 so -lpthread and -lrt should not be passed to the linker.
 Additionally, detect ARM/AArch64 from the cross-compiler target rather than
 inspecting the host architecture.
Author: Termux User Repository
Forwarded: not-needed
--- a/src/Makefile
+++ b/src/Makefile
@@ -222,7 +222,7 @@
 endif
 
 IS_AARCH64              := $(shell [ "$$(arch 2>/dev/null)" = "aarch64" ] && echo 1 || echo 0)
-IS_ARM                  := $(or $(filter 1,$(IS_APPLE_SILICON)),$(filter 1,$(IS_AARCH64)))
+IS_ARM                  := $(or $(filter 1,$(IS_APPLE_SILICON)),$(filter 1,$(IS_AARCH64)),$(if $(filter aarch64% arm%,$(CC) $(CC_NATIVE) $(TARGET_ARCH)),1,0))
 IS_PPC                  := $(shell uname -m | grep -q -E '^(ppc|powerpc)' && echo 1 || echo 0)
 
 ifneq (,$(filter $(UNAME),OpenBSD FreeBSD NetBSD DragonFly))
@@ -655,9 +655,7 @@
 CFLAGS_NATIVE           := $(CFLAGS)
 CFLAGS_NATIVE           += -D__ANDROID__
 LFLAGS_NATIVE           := $(LFLAGS)
-LFLAGS_NATIVE           += -lpthread
 LFLAGS_NATIVE           += -ldl
-LFLAGS_NATIVE           += -lrt
 LFLAGS_NATIVE           += -lm
 LFLAGS_NATIVE           += -L$(PREFIX)/lib
 $(info Android environment detected.)
