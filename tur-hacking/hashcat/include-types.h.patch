Description: Rename struct user to avoid clash with Bionic sys/user.h
 Bionic libc headers for 32-bit architectures (arm, i686) define struct user
 in <sys/user.h>. Renaming to struct user_hashcat avoids conflicting types.
Author: Termux User Repository
Forwarded: not-needed
--- a/include/types.h
+++ b/include/types.h
@@ -1335,7 +1335,7 @@
 
 } dynamicx_t;
 
-typedef struct user
+typedef struct user_hashcat
 {
   char *user_name;
   u32   user_len;
