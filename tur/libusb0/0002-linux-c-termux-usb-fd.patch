+/*
+ * Termux grants access to one USB device by inheriting an already-open
+ * descriptor and exporting its number in TERMUX_USB_FD.  Resolve that
+ * descriptor to the corresponding /dev/bus/usb/BBB/DDD path so that the
+ * legacy libusb-0.1 bus/device model can represent it.
+ */
+static int termux_usb_get_devinfo(int fd, int *busnum, int *devnum)
+{
+  char proc_path[PATH_MAX + 1];
+  char usb_path_name[PATH_MAX + 1];
+  ssize_t length;
+
+  snprintf(proc_path, sizeof(proc_path), "/proc/self/fd/%d", fd);
+
+  length = readlink(proc_path, usb_path_name, sizeof(usb_path_name) - 1);
+  if (length < 0)
+    return -1;
+
+  usb_path_name[length] = '\0';
+
+  if (sscanf(usb_path_name, "/dev/bus/usb/%d/%d", busnum, devnum) != 2)
+    return -1;
+
+  return 0;
+}
 
 static int device_open(struct usb_device *dev)
 {
   char filename[PATH_MAX + 1];
   int fd;
 
+  /*
+   * The descriptor supplied by termux-usb is the only usable access path
+   * under Android.  Never close the original descriptor; each libusb-0.1
+   * handle receives its own duplicate.
+   */
+  if (termux_usb_fd >= 0) {
+    fd = dup(termux_usb_fd);
+    if (fd < 0)
+      USB_ERROR_STR(-errno,
+        "failed to duplicate TERMUX_USB_FD: %s", strerror(errno));
+
+    return fd;
+  }
+
   snprintf(filename, sizeof(filename) - 1, "%s/%s/%s",
     usb_path, dev->bus->dirname, dev->filename);
 
