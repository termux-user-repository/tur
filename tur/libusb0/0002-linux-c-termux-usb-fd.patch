+  if (usb_debug >= 2) {
+    usb_trace_timestamp();
+    fprintf(stderr,
+      "usb_bulk_write enter: fd=%d ep=0x%02x requested=%d timeout=%d\n",
+      dev->fd, ep, size, timeout);
+  }
+
+  ret = usb_urb_transfer(dev, ep, USB_URB_TYPE_BULK,
+                         bytes, size, timeout);
+
+  if (usb_debug >= 2) {
+    usb_trace_timestamp();
+    fprintf(stderr,
+      "usb_bulk_write leave: fd=%d ep=0x%02x requested=%d ret=%d\n",
+      dev->fd, ep, size, ret);
+  }
+
+  return ret;
+}
