+int usb_bulk_read(usb_dev_handle *dev, int ep, char *bytes, int size,
+        int timeout)
+{
+  if (usb_debug) {
+    usb_trace_timestamp();
+    fprintf(stderr,
+      "ENTER usb_bulk_read: fd=%d ep=0x%02x size=%d timeout=%d\n",
+      dev->fd, ep, size, timeout);
+  }
+
+  int ret;
+
+  ep |= USB_ENDPOINT_IN;
+
+  if (usb_debug >= 2) {
+    usb_trace_timestamp();
+    fprintf(stderr,
+      "usb_bulk_read enter: fd=%d ep=0x%02x requested=%d timeout=%d\n",
+      dev->fd, ep, size, timeout);
+  }
+
+  ret = usb_urb_transfer(dev, ep, USB_URB_TYPE_BULK,
+                         bytes, size, timeout);
+
+  if (usb_debug >= 2) {
+    usb_trace_timestamp();
+    fprintf(stderr,
+      "usb_bulk_read leave: fd=%d ep=0x%02x requested=%d ret=%d\n",
+      dev->fd, ep, size, ret);
+  }
+
+  return ret;
+}
+
+
+int usb_bulk_write(usb_dev_handle *dev, int ep, char *bytes, int size,
+        int timeout)
