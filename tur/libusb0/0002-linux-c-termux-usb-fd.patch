+/* Diagnostic helpers */
+static const char *usb_transfer_name(int urbtype, int ep)
+{
+  if (urbtype == USB_URB_TYPE_BULK) {
+    if (ep & USB_ENDPOINT_IN)
+      return "bulk-read";
+    return "bulk-write";
+  }
