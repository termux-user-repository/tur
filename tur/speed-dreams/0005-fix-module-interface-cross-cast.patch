Description: Fix cross-DSO dynamic_cast across module boundaries on Android
 On Android Bionic, dlopened shared libraries retain distinct RTTI typeinfo
 addresses for header-only abstract interfaces. dynamic_cast fails when
 cross-casting from GfModule* to interfaces like ITrackLoader, IPhysicsEngine,
 etc. Provide queryInterface() fallback using static_cast within each module
 translation unit, and use RTLD_GLOBAL in linuxspec.cpp.
Author: Fervi <lordfervi@protonmail.com>

--- a/src/libs/tgf/tgf.hpp
+++ b/src/libs/tgf/tgf.hpp
@@ -35,6 +35,8 @@
 #include <vector>
 #include <map>
 #include <ostream>
+#include <typeinfo>
+#include <cstring>
 
 #include "tgf.h"
 
@@ -79,9 +81,14 @@
 	template <class Interface>
 	Interface* getInterface()
 	{
-		return dynamic_cast<Interface*>(this);
+		Interface* p = dynamic_cast<Interface*>(this);
+		if (p)
+			return p;
+		return (Interface*)queryInterface(typeid(Interface).name());
 	}
 
+	virtual void* queryInterface(const char* /*typeName*/) { return 0; }
+
  public: // Services for the module implementation.
 
 	//! Register a new module instance (aimed at being called by the GfModuleOpen function).
