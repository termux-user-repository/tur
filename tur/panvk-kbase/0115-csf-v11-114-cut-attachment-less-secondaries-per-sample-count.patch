+static void
 panvk_reset_cmdbuf(struct vk_command_buffer *vk_cmdbuf,
                    VkCommandBufferResetFlags flags)
 {
@@ -964,6 +1028,7 @@
       cs_builder_fini(&cmdbuf->state.cs[i].builder);
 
