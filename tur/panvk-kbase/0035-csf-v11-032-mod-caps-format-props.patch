index a86597c8532959183f33ce85bc3c692785b300c8..9c6d5bc73ba0382f7e3c5965a782725c9bb99d09 100644
--- a/src/panfrost/vulkan/panvk_image.c
+++ b/src/panfrost/vulkan/panvk_image.c
@@ -33,44 +33,6 @@
