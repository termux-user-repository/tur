    bool (*match)(uint64_t mod);
 
+   /* Get the capabilities for a specific format/modifier pair. Returns 0
+    * if this combination is not valid on this platform, or a bitmask of
+    * PAN_MOD_FORMAT_CAP_* flags if valid.
