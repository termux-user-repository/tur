@@ -0,0 +1,54 @@
+/*
+ * Copyright 2026 Abhay Byte
+ * SPDX-License-Identifier: MIT
+ */
+
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define PANLIB_VP_RUN_HEADER_BYTES 12u
+#define PANLIB_VP_RUN_BYTES 12u
+#define PANLIB_VP_MAX_VIEWPORTS 16u
+#define PANLIB_VP_RESTART 0xffffffffu
+#define PANLIB_VP_MAX_INPUT_INDICES (1u << 24)
+#define PANLIB_VP_MAX_OUT_INDICES (1u << 24)
+#define PANLIB_VP_MAX_RUNS ((UINT32_MAX - PANLIB_VP_RUN_HEADER_BYTES) / PANLIB_VP_RUN_BYTES)
+
+struct panlib_vp_run {
+   uint32_t viewport;
+   uint32_t first_index;
+   uint32_t index_count;
+};
+
+struct panlib_vp_run_header {
+   uint32_t index_count;
+   uint32_t run_count;
+   uint32_t overflow;
+};
+
+/* Selected-viewport depth clamp, two little-endian floats. The run loop
+ * walks this with an immediate subtract: v11 cannot add a shifted
+ * viewport to a base address.
+ */
+struct panlib_vp_clamp {
+   float z_min;
+   float z_max;
+};
+
+/* The kernel argument struct is emitted by the libpan shader generator
+ * from panlib_vp_runs_launch. outputs_written is the GS mask before the
+ * passthrough drops the viewport bit.
+ */
+
+static inline bool
+panlib_vp_run_bytes(uint32_t run_capacity, uint64_t *bytes)
+{
+   if (run_capacity > PANLIB_VP_MAX_RUNS)
+      return false;
+
+   *bytes = PANLIB_VP_RUN_HEADER_BYTES +
+            (uint64_t)run_capacity * PANLIB_VP_RUN_BYTES;
+   return true;
+}
diff --git a/src/panfrost/libpan/tests/vp_runs.c b/src/panfrost/libpan/tests/vp_runs.c
new file mode 100644
index 00000000000..f17c9c78181
--- /dev/null
+++ b/src/panfrost/libpan/tests/vp_runs.c
@@ -0,0 +1,346 @@
+/*
+ * Host emulation of panlib_vp_runs. Same .cl body.
+ * Topology and the packed-slot rank are the production helpers.
+ * libcl headers shadow libc, so they are not on the include path.
+ * OpenCL address-space words are empty here.
+ *
+ *   gcc -std=c11 -Wall -Werror -o /tmp/vp-runs \
+ *     src/panfrost/libpan/tests/vp_runs.c \
+ *     -Isrc/panfrost/libpan -Iinclude -Isrc -Isrc/panfrost \
+ *     && /tmp/vp-runs
+ */
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define global
+#define constant
+#define kernel
+#define __global
+#define __constant
+#define __kernel
+#define __attribute__(x)
+typedef unsigned int uint;
+
+#define UTIL_ARCH_LITTLE_ENDIAN 1
+#define UTIL_ARCH_BIG_ENDIAN 0
+#include "util/bitscan.h"
+#include "compiler/shader_enums.h"
+#include "poly/prim.h"
+
+#define PANLIB_VP_HOST 1
+#include "draw_helper_vp.h"
+#include "vp_runs.cl"
+
+#undef kernel
+#undef global
+
+#define CHECK(c)                                                               \
+   do {                                                                        \
+      if (!(c)) {                                                              \
+         fprintf(stderr, "vp_runs: %s\n", #c);                                 \
+         return 1;                                                             \
+      }                                                                        \
+   } while (0)
+
+#define STRIDE 512u
+
+static uint64_t
+outputs_with_viewport(void)
+{
+   return ((1ull << VARYING_SLOT_VIEWPORT) - 1) | VARYING_BIT_VIEWPORT;
+}
+
+static uint32_t
+vp_slot(void)
+{
+   return util_bitcount64(outputs_with_viewport() &
+                          BITFIELD64_MASK(VARYING_SLOT_VIEWPORT));
+}
+
+static void
+put_vp(uint32_t *rec, uint32_t id, uint32_t vp)
+{
+   rec[id * (STRIDE / 4) + vp_slot() * 4] = vp;
+   rec[id * (STRIDE / 4)] = 7;
+}
+
+static void
+call(const uint32_t *idx, uint32_t nidx, const uint32_t *rec, uint64_t outputs,
+     uint32_t vp_count, uint32_t prim, uint32_t prov_last, uint32_t icap,
+     uint32_t rcap, uint32_t *out, struct panlib_vp_run_header *hdr)
+{
+   memset(hdr, 0xa5, sizeof(*hdr) + 8 * sizeof(struct panlib_vp_run));
+   memset(out, 0xa5, 64 * sizeof(uint32_t));
+   panlib_vp_runs(idx, nidx, rec, STRIDE, outputs, vp_count, prim, prov_last,
+                  icap, rcap, out, hdr);
+}
+
+static int
+one_mode(uint32_t *rec, uint32_t prim, uint32_t prov_last, uint32_t nprim,
+         const uint32_t *expect_idx, const uint32_t *expect_vp)
+{
+   uint32_t idx[16];
+   uint32_t out[64];
+   struct {
+      struct panlib_vp_run_header h;
+      struct panlib_vp_run r[8];
+   } buf;
+   uint32_t nidx = prim == MESA_PRIM_POINTS ? nprim :
+                   prim == MESA_PRIM_LINES  ? nprim * 2 :
+                                              2 + nprim;
+
+   for (uint32_t i = 0; i < nidx; i++)
+      idx[i] = 10 + i;
+
+   call(idx, nidx, rec, outputs_with_viewport(), 4, prim, prov_last, 64, 8,
+        out, &buf.h);
+   CHECK(!buf.h.overflow);
+   CHECK(buf.h.index_count == nidx);
+   CHECK(buf.h.run_count >= 1);
+   for (uint32_t i = 0; i < nidx; i++)
+      CHECK(out[i] == expect_idx[i]);
+
+   uint32_t covered = 0;
+   for (uint32_t r = 0; r < buf.h.run_count; r++) {
+      CHECK(buf.r[r].first_index == covered);
+      CHECK(buf.r[r].viewport == expect_vp[r]);
+      covered += buf.r[r].index_count;
+   }
+   CHECK(covered == nidx);
+   return 0;
+}
+
+int
+main(void)
+{
+   CHECK(sizeof(struct panlib_vp_run_header) == PANLIB_VP_RUN_HEADER_BYTES);
+   CHECK(sizeof(struct panlib_vp_run) == PANLIB_VP_RUN_BYTES);
+   CHECK(util_bitcount64(outputs_with_viewport() &
+                         BITFIELD64_MASK(VARYING_SLOT_VIEWPORT)) ==
+         VARYING_SLOT_VIEWPORT);
+
+   uint64_t bytes = 0;
+   CHECK(panlib_vp_run_bytes(0, &bytes) && bytes == PANLIB_VP_RUN_HEADER_BYTES);
+   CHECK(panlib_vp_run_bytes(PANLIB_VP_MAX_RUNS, &bytes));
+   CHECK(!panlib_vp_run_bytes(PANLIB_VP_MAX_RUNS + 1, &bytes));
+   CHECK(bytes == PANLIB_VP_RUN_HEADER_BYTES + (uint64_t)PANLIB_VP_MAX_RUNS * 12);
+
+   uint32_t *rec = calloc(40, STRIDE);
+   CHECK(rec);
+   memset(rec, 0, 32 * STRIDE);
+   /* records 10..: viewports 0,0,1,1,1 then 2,9 */
+   put_vp(rec, 10, 0);
+   put_vp(rec, 11, 0);
+   put_vp(rec, 12, 1);
+   put_vp(rec, 13, 1);
+   put_vp(rec, 14, 1);
+   put_vp(rec, 15, 2);
+   put_vp(rec, 16, 9);
+
+   uint32_t out[64];
+   struct {
+      struct panlib_vp_run_header h;
+      struct panlib_vp_run r[8];
+   } buf;
+   uint64_t outs = outputs_with_viewport();
+
+   /* points: each point is its own run, 9 clamps to last viewport */
+   {
+      uint32_t idx[] = {10, 12, 16};
+      call(idx, 3, rec, outs, 4, MESA_PRIM_POINTS, 0, 64, 8, out, &buf.h);
+      CHECK(!buf.h.overflow && buf.h.run_count == 3 && buf.h.index_count == 3);
+      CHECK(buf.r[0].viewport == 0 && buf.r[1].viewport == 1 &&
+            buf.r[2].viewport == 3);
+      CHECK(out[0] == 10 && out[1] == 12 && out[2] == 16);
+   }
+
+   /* lines, list: (10,11) vp0, (12,13) vp1. Provoking last. */
+   {
+      uint32_t ei[] = {10, 11, 12, 13};
+      uint32_t ev[] = {0, 1};
+      CHECK(one_mode(rec, MESA_PRIM_LINES, 1, 2, ei, ev) == 0);
+   }
+
+   /* line strip, provoking last: (10,11) vp0, (11,12) vp1 */
+   {
+      uint32_t idx[] = {10, 11, 12};
+      call(idx, 3, rec, outs, 4, MESA_PRIM_LINE_STRIP, 1, 64, 8, out, &buf.h);
+      CHECK(!buf.h.overflow && buf.h.run_count == 2);
+      CHECK(buf.r[0].viewport == 0 && buf.r[0].index_count == 2);
+      CHECK(buf.r[1].viewport == 1 && buf.r[1].first_index == 2);
+      CHECK(out[2] == 11 && out[3] == 12);
+   }
+
+   /* triangles, list, one prim, provoking last is record 12 */
+   {
+      uint32_t ei[] = {10, 11, 12};
+      uint32_t ev[] = {1};
+      CHECK(one_mode(rec, MESA_PRIM_TRIANGLES, 1, 1, ei, ev) == 0);
+   }
+
+   /* triangle strip, provoking last, odd primitive swaps */
+   {
+      uint32_t idx[] = {10, 11, 12, 13, 14};
+      call(idx, 5, rec, outs, 4, MESA_PRIM_TRIANGLE_STRIP, 1, 64, 8, out,
+           &buf.h);
+      CHECK(!buf.h.overflow && buf.h.index_count == 9 && buf.h.run_count == 1);
+      CHECK(buf.r[0].viewport == 1 && buf.r[0].index_count == 9);
+      CHECK(out[0] == 10 && out[1] == 11 && out[2] == 12);
+      CHECK(out[3] == 12 && out[4] == 11 && out[5] == 13);
+      CHECK(out[6] == 12 && out[7] == 13 && out[8] == 14);
+   }
+
+   /* provoking first splits the strip: vp0 then vp1 */
+   {
+      uint32_t idx[] = {10, 11, 12, 13, 14};
+      call(idx, 5, rec, outs, 4, MESA_PRIM_TRIANGLE_STRIP, 0, 64, 8, out,
+           &buf.h);
+      CHECK(buf.h.run_count == 2);
+      CHECK(buf.r[0].viewport == 0 && buf.r[0].index_count == 6);
+      CHECK(buf.r[1].viewport == 1 && buf.r[1].first_index == 6 &&
+            buf.r[1].index_count == 3);
+      CHECK(out[3] == 11 && out[4] == 13 && out[5] == 12);
+   }
+
+   /* restart drops the tail of a strip and starts another */
+   {
+      uint32_t idx[] = {10, 11, 12, PANLIB_VP_RESTART, 15, 16};
+      call(idx, 6, rec, outs, 4, MESA_PRIM_LINE_STRIP, 1, 64, 8, out, &buf.h);
+      CHECK(!buf.h.overflow && buf.h.index_count == 6 && buf.h.run_count == 3);
+      CHECK(buf.r[0].viewport == 0 && out[0] == 10 && out[1] == 11);
+      CHECK(buf.r[1].viewport == 1 && out[2] == 11 && out[3] == 12);
+      CHECK(buf.r[2].viewport == 3 && out[4] == 15 && out[5] == 16);
+   }
+
+   /* no viewport output: every provoking vertex is viewport 0, one run */
+   {
+      uint32_t idx[] = {10, 12, 16};
+      call(idx, 3, rec, 0, 4, MESA_PRIM_POINTS, 0, 64, 8, out, &buf.h);
+      CHECK(buf.h.run_count == 1 && buf.r[0].viewport == 0 &&
+            buf.r[0].index_count == 3);
+   }
+
+   /* exact index cap merges into the open run; one past fails closed */
+   {
+      uint32_t idx[] = {10, 11, 12, 13};
+      call(idx, 4, rec, outs, 4, MESA_PRIM_TRIANGLE_STRIP, 1, 6, 1, out,
+           &buf.h);
+      CHECK(!buf.h.overflow && buf.h.index_count == 6 && buf.h.run_count == 1);
+      call(idx, 4, rec, outs, 4, MESA_PRIM_TRIANGLE_STRIP, 1, 5, 8, out,
+           &buf.h);
+      CHECK(buf.h.overflow == 1 && buf.h.index_count == 0 &&
+            buf.h.run_count == 0);
+   }
+
+   /* exact run cap, then one past: different viewports cannot merge */
+   {
+      uint32_t idx[] = {10, 12};
+      call(idx, 2, rec, outs, 4, MESA_PRIM_POINTS, 0, 64, 2, out, &buf.h);
+      CHECK(!buf.h.overflow && buf.h.run_count == 2);
+      call(idx, 2, rec, outs, 4, MESA_PRIM_POINTS, 0, 64, 1, out, &buf.h);
+      CHECK(buf.h.overflow == 1 && buf.h.index_count == 0 &&
+            buf.h.run_count == 0);
+   }
+
+   /* empty input and a restart-only buffer are valid empty draws */
+   {
+      call(NULL, 0, rec, outs, 4, MESA_PRIM_POINTS, 0, 64, 8, out, &buf.h);
+      CHECK(!buf.h.overflow && buf.h.index_count == 0 && buf.h.run_count == 0);
+      uint32_t holes[] = {PANLIB_VP_RESTART, PANLIB_VP_RESTART};
+      call(holes, 2, rec, outs, 4, MESA_PRIM_TRIANGLE_STRIP, 1, 64, 8, out,
+           &buf.h);
+      CHECK(!buf.h.overflow && buf.h.index_count == 0 && buf.h.run_count == 0);
+   }
+
+   /* zero capacities: nothing emitted is fine, one primitive is overflow */
+   {
+      uint32_t idx[] = {10};
+      call(idx, 0, rec, outs, 4, MESA_PRIM_POINTS, 0, 0, 0, out, &buf.h);
+      CHECK(!buf.h.overflow && buf.h.index_count == 0);
+      call(idx, 1, rec, outs, 4, MESA_PRIM_POINTS, 0, 0, 0, out, &buf.h);
+      CHECK(buf.h.overflow == 1 && buf.h.index_count == 0 &&
+            buf.h.run_count == 0);
+   }
+
+   /* absent viewport, record_stride 0: one run, viewport 0, no record read */
+   {
+      uint32_t idx[] = {10, 11, 12};
+      memset(&buf, 0, sizeof(buf));
+      panlib_vp_runs(idx, 3, NULL, 0, 0, 4, MESA_PRIM_POINTS, 0, 64, 8, out,
+                     &buf.h);
+      CHECK(!buf.h.overflow && buf.h.run_count == 1 && buf.r[0].viewport == 0 &&
+            buf.r[0].index_count == 3);
+   }
+
+   /* sparse mask: only viewport bit set, so the slot rank is 0 */
+   {
+      uint32_t idx[] = {0};
+      rec[0] = 2;
+      call(idx, 1, rec, VARYING_BIT_VIEWPORT, 4, MESA_PRIM_POINTS, 0, 64, 8,
+           out, &buf.h);
+      CHECK(!buf.h.overflow && buf.h.run_count == 1 && buf.r[0].viewport == 2);
+      rec[0] = 7;
+   }
+
+   /* quads are not a GS output mode */
+   {
+      uint32_t idx[] = {10, 11, 12, 13};
+      call(idx, 4, rec, outs, 4, MESA_PRIM_QUADS, 1, 64, 8, out, &buf.h);
+      CHECK(buf.h.overflow == 1 && buf.h.index_count == 0 &&
+            buf.h.run_count == 0);
+   }
+
+   /* restart inside a triangle strip: odd primitive after the cut */
+   {
+      uint32_t idx[] = {10, 11, 12, 13, PANLIB_VP_RESTART, 12, 13, 14};
+      call(idx, 8, rec, outs, 4, MESA_PRIM_TRIANGLE_STRIP, 1, 64, 8, out,
+           &buf.h);
+      /* First segment: even (10,11,12), odd swapped (12,11,13).
+       * Restart resets parity, so the next segment starts even again.
+       */
+      CHECK(!buf.h.overflow && buf.h.index_count == 9 && buf.h.run_count == 1);
+      CHECK(out[0] == 10 && out[1] == 11 && out[2] == 12);
+      CHECK(out[3] == 12 && out[4] == 11 && out[5] == 13);
+      CHECK(out[6] == 12 && out[7] == 13 && out[8] == 14);
+      CHECK(buf.r[0].viewport == 1);
+   }
+
+   /* canaries past the written indices and past the one run stay put */
+   {
+      uint32_t idx[] = {10};
+      memset(out, 0xa5, 64 * sizeof(uint32_t));
+      memset(&buf, 0xa5, sizeof(buf));
+      panlib_vp_runs(idx, 1, rec, STRIDE, outs, 4, MESA_PRIM_POINTS, 0, 64, 8,
+                     out, &buf.h);
+      CHECK(!buf.h.overflow && buf.h.index_count == 1 && buf.h.run_count == 1);
+      CHECK(out[0] == 10 && out[1] == 0xa5a5a5a5u);
+      CHECK(buf.r[1].viewport == 0xa5a5a5a5u);
+   }
+
+   /* limits: an output capacity past the documented bound discards the draw */
+   {
+      uint32_t idx[] = {10};
+      call(idx, 1, rec, outs, 4, MESA_PRIM_POINTS, 0,
+           PANLIB_VP_MAX_OUT_INDICES + 1, 1, out, &buf.h);
+      CHECK(buf.h.overflow == 1 && buf.h.index_count == 0 &&
+            buf.h.run_count == 0);
+      call(idx, PANLIB_VP_MAX_INPUT_INDICES + 1, rec, outs, 4, MESA_PRIM_POINTS,
+           0, 64, 1, out, &buf.h);
+      CHECK(buf.h.overflow == 1 && buf.h.run_count == 0);
+   }
+
+   /* A count past the output capacity discards the draw. */
+   {
+      uint32_t idx[] = {10, 11, 12};
+      call(idx, 3, rec, outs, 4, MESA_PRIM_POINTS, 0, 2, 8, out, &buf.h);
+      CHECK(buf.h.overflow == 1 && buf.h.index_count == 0 &&
+            buf.h.run_count == 0);
+   }
+
+   free(rec);
+   printf("vp_runs ok\n");
+   return 0;
+}
diff --git a/src/panfrost/libpan/vp_runs.cl b/src/panfrost/libpan/vp_runs.cl
new file mode 100644
index 00000000000..74753673464
--- /dev/null
+++ b/src/panfrost/libpan/vp_runs.cl
@@ -0,0 +1,192 @@
+#ifdef PANLIB_VP_HOST
+#define VP_GLOBAL
+#define VP_CONST const
+#else
+#define VP_GLOBAL global
+#define VP_CONST global const
+#endif
+
+static bool
+vp_add_u32(uint32_t a, uint32_t b, uint32_t *out)
+{
+   if (a > UINT32_MAX - b)
+      return false;
+   *out = a + b;
+   return true;
+}
+
+/* Provoking vertex's packed slot, clamped into the active table.
+ * Missing slot is viewport 0. count is at least 1.
+ */
+static uint32_t
+vp_prim_viewport(VP_CONST uint32_t *records, uint32_t record_stride,
+                 uint32_t vp_slot, bool has_vp, uint32_t provoking,
+                 uint32_t count)
+{
+   uint32_t vp = 0;
+
+   if (has_vp) {
+      VP_CONST uint32_t *rec =
+         (VP_CONST uint32_t *)((VP_CONST char *)records +
+                               (uint64_t)provoking * record_stride);
+      vp = rec[vp_slot * 4];
+   }
+   return vp < count ? vp : count - 1;
+}
+
+/* A new run needs a free slot. A merge into the open run does not.
+ * Either way the primitive's vertices must fit. Failure discards later.
+ */
+static bool
+vp_emit(VP_GLOBAL uint32_t *out_indices, VP_GLOBAL struct panlib_vp_run *runs,
+        uint32_t *nidx, uint32_t *nrun, uint32_t index_cap, uint32_t run_cap,
+        uint32_t vp, uint32_t k, const uint32_t *vtx)
+{
+   uint32_t next;
+   bool merge = *nrun && runs[*nrun - 1].viewport == vp &&
+                runs[*nrun - 1].first_index + runs[*nrun - 1].index_count == *nidx;
+
+   if (!vp_add_u32(*nidx, k, &next) || next > index_cap)
+      return false;
+   if (!merge && (*nrun >= run_cap || !vp_add_u32(*nrun, 1, &next)))
+      return false;
+
+   if (merge)
+      runs[*nrun - 1].index_count += k;
+   else {
+      runs[*nrun].viewport = vp;
+      runs[*nrun].first_index = *nidx;
+      runs[*nrun].index_count = k;
+      (*nrun)++;
+   }
+   for (uint32_t v = 0; v < k; v++)
+      out_indices[(*nidx)++] = vtx[v];
+   return true;
+}
+
+static bool
+vp_prim(VP_CONST uint32_t *in_indices, VP_CONST uint32_t *records,
+        uint32_t record_stride, uint32_t vp_slot, bool has_vp, uint32_t count,
+        uint32_t prim, bool provoking_last, uint32_t p, uint32_t num_prims,
+        uint32_t base, VP_GLOBAL uint32_t *out_indices,
+        VP_GLOBAL struct panlib_vp_run *runs, uint32_t *nidx, uint32_t *nrun,
+        uint32_t index_cap, uint32_t run_cap)
+{
+   uint32_t k = mesa_vertices_per_prim((enum mesa_prim)prim);
+   uint32_t vtx[3];
+   uint32_t prov = provoking_last ? k - 1 : 0;
+
+   if (k == 0 || k > 3)
+      return false;
+
+   for (uint32_t v = 0; v < k; v++) {
+      uint32_t at;
+      if (!vp_add_u32(base, poly_vertex_id_for_topology((enum mesa_prim)prim,
+                                                     !provoking_last, p, v,
+                                                     num_prims),
+                      &at))
+         return false;
+      vtx[v] = in_indices[at];
+   }
+   return vp_emit(out_indices, runs, nidx, nrun, index_cap, run_cap,
+                  vp_prim_viewport(records, record_stride, vp_slot, has_vp,
+                                   vtx[prov], count),
+                  k, vtx);
+}
+
+static void
+panlib_vp_runs(VP_CONST uint32_t *in_indices, uint32_t index_count,
+               VP_CONST uint32_t *records, uint32_t record_stride,
+               uint64_t outputs_written, uint32_t viewport_count,
+               uint32_t prim, uint32_t provoking_last, uint32_t index_capacity,
+               uint32_t run_capacity, VP_GLOBAL uint32_t *out_indices,
+               VP_GLOBAL struct panlib_vp_run_header *header)
+{
+   bool has_vp = (outputs_written & VARYING_BIT_VIEWPORT) != 0;
+   uint32_t vp_slot = util_bitcount64(outputs_written &
+                                      BITFIELD64_MASK(VARYING_SLOT_VIEWPORT));
+   uint32_t count = viewport_count ? viewport_count : 1;
+   uint32_t slot_bytes;
+   bool overflow = false;
+   bool accepted = prim == MESA_PRIM_POINTS || prim == MESA_PRIM_LINES ||
+                   prim == MESA_PRIM_LINE_STRIP || prim == MESA_PRIM_TRIANGLES ||
+                   prim == MESA_PRIM_TRIANGLE_STRIP;
+
+   if (count > PANLIB_VP_MAX_VIEWPORTS)
+      count = PANLIB_VP_MAX_VIEWPORTS;
+   /* Empty input is a valid empty draw. Stride is checked only when a
+    * viewport slot is actually read. record_stride 0 is fine if aligned
+    * and the slot is absent.
+    */
+   if (!accepted || index_count > PANLIB_VP_MAX_INPUT_INDICES ||
+       index_count > index_capacity ||
+       index_capacity > PANLIB_VP_MAX_OUT_INDICES ||
+       run_capacity > PANLIB_VP_MAX_RUNS || (record_stride & 3) ||
+       (has_vp && (!vp_add_u32(vp_slot * 16, 4, &slot_bytes) ||
+                   slot_bytes > record_stride)))
+      overflow = true;
+
+   VP_GLOBAL struct panlib_vp_run *runs =
+      (VP_GLOBAL struct panlib_vp_run *)(header + 1);
+   uint32_t nidx = 0, nrun = 0;
+   bool prov_last = provoking_last != 0;
+   uint32_t needle = 0;
+
+   while (needle < index_count && !overflow) {
+      uint32_t next = index_count;
+
+      for (uint32_t i = needle; i < index_count; i++) {
+         if (in_indices[i] == PANLIB_VP_RESTART) {
+            next = i;
+            break;
+         }
+      }
+
+      uint32_t len = next - needle;
+      uint32_t prims =
+         u_decomposed_prims_for_vertices((enum mesa_prim)prim, (int)len);
+
+      for (uint32_t p = 0; p < prims && !overflow; p++) {
+         overflow = !vp_prim(in_indices, records, record_stride, vp_slot,
+                             has_vp, count, prim, prov_last, p, prims,
+                             needle, out_indices, runs, &nidx, &nrun,
+                             index_capacity, run_capacity);
+      }
+      if (!vp_add_u32(next, 1, &needle))
+         overflow = true;
+   }
+
+   /* Fail closed: a partial draw is not a draw. */
+   header->index_count = overflow ? 0 : nidx;
+   header->run_count = overflow ? 0 : nrun;
+   header->overflow = overflow ? 1 : 0;
+}
