+        else
+        {
+            if (bits == 0)
+                lerped = ep0;
+            else if (bits == 1)
+                lerped = ep1;
+            else
+                lerped = 0.5 * (ep0 + ep1);
+            res = vec4(lerped, 1.0);
+        }
+    }
+
+    return res;
+}
+
+float decode_alpha_4bit(uvec2 payload, int pixel)
+{
+    uint offset = pixel * 4;
+    return float((payload[offset >> 5] >> (offset & 31)) & 0xf) / 15.0;
+}
+
+void main()
+{
+    int format = registers.format;
+    int x = int(gl_GlobalInvocationID.x);
+    int y = int(gl_GlobalInvocationID.y);
+    int z = int(gl_GlobalInvocationID.z);
+
+    if (x >= registers.width || y >= registers.height || z >= registers.depth)
+        return;
+
+    ivec2 pixel_coord = ivec2(x, y) % 4;
+    int linear_pixel = 4 * pixel_coord.y + pixel_coord.x;
+    InBuf ibuf = InBuf(registers.src);
+    OutBuf obuf = OutBuf(registers.dst);
+    uint in_word = (uint(z) * registers.src_slice_B + uint(y / 4) * registers.src_row_B) / 4u;
+    uint out_word = (uint(z) * registers.dst_slice_B + uint(y) * registers.dst_row_B) / 4u;
+
+    uint bw = (format <= VK_FORMAT_BC1_RGBA_SRGB_BLOCK) ? 2u : 4u;
+    uint w = in_word + uint(x / 4) * bw;
+    uvec2 color_payload, alpha_payload;
+    vec3 ep0, ep1;
+    bool opaque_mode;
+    vec4 decoded;
+
+    if (bw == 2u) {
+        color_payload = uvec2(ibuf.data[w], ibuf.data[w + 1u]);
+        opaque_mode = decode_endpoints_color(format, color_payload.x, ep0, ep1);
+        decoded = interpolate_endpoint_color(ep0, ep1, int((color_payload.y >> (2 * linear_pixel)) & 3), opaque_mode);
+    } else {
+        color_payload = uvec2(ibuf.data[w + 2u], ibuf.data[w + 3u]);
+        alpha_payload = uvec2(ibuf.data[w], ibuf.data[w + 1u]);
+        opaque_mode = decode_endpoints_color(format, color_payload.x, ep0, ep1);
+        decoded = interpolate_endpoint_color(ep0, ep1, int((color_payload.y >> (2 * linear_pixel)) & 3), opaque_mode);
+        if (format <= VK_FORMAT_BC2_SRGB_BLOCK)
+            decoded.a = decode_alpha_4bit(alpha_payload, linear_pixel);
+        else
+            decoded.a = decode_alpha_rgtc(alpha_payload, linear_pixel);
+    }
+
+    obuf.data[out_word + uint(x)] = packUnorm4x8(decoded);
+}
