+struct panvk_bc_decode_push {
+   uint32_t src[2];
+   uint32_t dst[2];
+   uint32_t src_row_B;
+   uint32_t src_slice_B;
+   uint32_t dst_row_B;
+   uint32_t dst_slice_B;
+   int32_t width;
