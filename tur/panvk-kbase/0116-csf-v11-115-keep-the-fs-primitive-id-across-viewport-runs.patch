diff --git a/src/panfrost/libpan/draw_helper_vp.h b/src/panfrost/libpan/draw_helper_vp.h
--- a/src/panfrost/libpan/draw_helper_vp.h
+++ b/src/panfrost/libpan/draw_helper_vp.h
@@ -12,6 +12,12 @@
 #define PANLIB_VP_RUN_BYTES 12u
 #define PANLIB_VP_MAX_VIEWPORTS 16u
 #define PANLIB_VP_RESTART 0xffffffffu
+/* pack_prim_id: run index = record | (primitive ID & 0xffff) << 16. Records
+ * are capped at 65536 (PANVK_GPU_PRERAST_MAX_INVOCATIONS). Run draws have
+ * primitive restart off, so any value is a vertex.
+ */
+#define PANLIB_VP_PRIM_ID_SHIFT 16u
+#define PANLIB_VP_PACKED_RECORD_MASK 0xffffu
 #define PANLIB_VP_MAX_INPUT_INDICES (1u << 24)
 #define PANLIB_VP_MAX_OUT_INDICES (1u << 24)
 #define PANLIB_VP_MAX_RUNS ((UINT32_MAX - PANLIB_VP_RUN_HEADER_BYTES) / PANLIB_VP_RUN_BYTES)
diff --git a/src/panfrost/libpan/tests/vp_runs.c b/src/panfrost/libpan/tests/vp_runs.c
--- a/src/panfrost/libpan/tests/vp_runs.c
+++ b/src/panfrost/libpan/tests/vp_runs.c
@@ -354,7 +354,7 @@
       for (uint32_t i = 0; i < 2; i++)
          idx[i] += 20;
       panlib_vp_runs_n(idx, 2, rec, STRIDE, outs, 4, MESA_PRIM_POINTS, 0, 64,
-                       8, out, &buf.h, 2, 2);
+                       8, out, &buf.h, 2, 2, 0, 0);
       CHECK(!buf.h.overflow && buf.h.index_count == 4 && buf.h.run_count == 3);
       CHECK(out[0] == 20 && out[1] == 21 && out[2] == 22 && out[3] == 23);
       CHECK(buf.r[0].viewport == 0 && buf.r[0].index_count == 1);
@@ -363,8 +363,37 @@
       CHECK(buf.r[2].viewport == 0 && buf.r[2].first_index == 3);
       /* the instance offset must not wrap */
       panlib_vp_runs_n(idx, 2, rec, STRIDE, outs, 4, MESA_PRIM_POINTS, 0, 64,
-                       8, out, &buf.h, 2, 0xffffffffu);
+                       8, out, &buf.h, 2, 0xffffffffu, 0, 0);
       CHECK(buf.h.overflow == 1 && buf.h.run_count == 0);
+
+      /* pack_prim_id: the primitive ID rides in bits 16+, per instance. */
+      panlib_vp_runs_n(idx, 2, rec, STRIDE, outs, 4, MESA_PRIM_POINTS, 0, 64,
+                       8, out, &buf.h, 2, 2, 1, 0);
+      CHECK(!buf.h.overflow && buf.h.index_count == 4 && buf.h.run_count == 3);
+      CHECK(out[0] == 20 && out[1] == (21 | 1u << 16) && out[2] == 22 &&
+            out[3] == (23 | 1u << 16));
+   }
+
+   /* pack_prim_id counts across a restart, and a record past 16 bits
+    * discards the draw.
+    */
+   {
+      uint32_t idx[] = {20, PANLIB_VP_RESTART, 21};
+      panlib_vp_runs_n(idx, 3, rec, STRIDE, outs, 4, MESA_PRIM_POINTS, 0, 64,
+                       8, out, &buf.h, 1, 0, 1, 0);
+      CHECK(!buf.h.overflow && buf.h.index_count == 2);
+      CHECK(out[0] == 20 && out[1] == (21 | 1u << 16));
+
+      uint32_t big[] = {0x10000};
+      panlib_vp_runs_n(big, 1, NULL, 0, 0, 4, MESA_PRIM_POINTS, 0, 64, 8, out,
+                       &buf.h, 1, 0, 1, 0);
+      CHECK(buf.h.overflow == 1);
+
+      /* A CPU-split chunk starts at its primitive base, IDs wrap at 16 bits. */
+      uint32_t two[] = {20, 21};
+      panlib_vp_runs_n(two, 2, rec, STRIDE, outs, 4, MESA_PRIM_POINTS, 0, 64,
+                       8, out, &buf.h, 1, 0, 1, 0xffff);
+      CHECK(!buf.h.overflow && out[0] == (20 | 0xffffu << 16) && out[1] == 21);
    }
 
    free(rec);
diff --git a/src/panfrost/libpan/vp_runs.cl b/src/panfrost/libpan/vp_runs.cl
--- a/src/panfrost/libpan/vp_runs.cl
+++ b/src/panfrost/libpan/vp_runs.cl
