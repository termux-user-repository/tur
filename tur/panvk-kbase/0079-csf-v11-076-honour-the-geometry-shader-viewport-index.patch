+static void
+panvk_full_fb_box(const struct panvk_cmd_buffer *cmdbuf,
+                  uint32_t *max_x, uint32_t *max_y)
+{
+   uint32_t w = cmdbuf->state.gfx.render.fb.layout.width_px;
+   uint32_t h = cmdbuf->state.gfx.render.fb.layout.height_px;
+
+   if (!w)
