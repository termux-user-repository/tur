+   for (int attempt = 0; attempt < max_attempts; attempt++) {
+      uint64_t atom = kbase_kmod_job_submit(dev, jc, core_req, bos, nbo,
+                                           ext_res, next_res);
+      if (!atom)
+         return false;
+      if (kbase_kmod_wait_atom(dev, atom, -1))
+         return true;
+
+      if (attempt + 1 < max_attempts) {
+         int64_t delay_ms = 400ll * (attempt + 1);
+         struct timespec ts = {
