+
+   out->params = params.gpu;
+   out->draw = draw.gpu;
+   out->job = v9_prerast_job(cmdbuf, kernel, gs_desc->res_table, push.gpu,
+                             indirect ? 1 : src->vertex.count,
+                             indirect ? 1 : src->instance.count,
+                             gsi->invocations, indirect);
+   return out->job.gpu != 0;
