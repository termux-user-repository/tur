+      cmdbuf, desc, sizeof(struct panvk_gpu_prerast_gs_params), 64);
+   struct pan_ptr draw = panvk_cmd_alloc_dev_mem(
+      cmdbuf, desc, sizeof(VkDrawIndexedIndirectCommand), 16);
+   if (!params.gpu || !draw.gpu)
+      return false;
