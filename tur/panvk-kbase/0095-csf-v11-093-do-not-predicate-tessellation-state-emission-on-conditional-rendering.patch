From 91f802607c3445ddba65d93c260e47bb736007d7 Mon Sep 17 00:00:00 2001
From: abhay-byte <abhay02delhi@gmail.com>
Date: Sat, 3 Oct 2026 12:02:33 +0530
Subject: [PATCH 1/3] panvk: do not predicate tessellation state emission on
 conditional rendering biblioklept

The tessellation chunk loop wrapped the whole raster draw, including the
state emission, in cs_if(predicate). Dirty flags are cleared while the
command stream is recorded, so a conditional draw that was skipped on the
GPU left the next draw without the state it needed. Only the launch is
predicated, by panvk_cond_render in launch_draw/launch_indirect_draw.

Generated-by: LLM
---
 src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c | 22 ++++++++-------------
 1 file changed, 8 insertions(+), 14 deletions(-)

diff --git a/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
index 5fe4d4d355e..7b99e028de3 100644
--- a/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
@@ -5236,21 +5236,15 @@ gpu_prerast_tess(struct panvk_cmd_buffer *cmdbuf,
       cmdbuf->state.gfx.vs.shader = tes;
       gfx_state_set_dirty(cmdbuf, VS);
       gfx_state_set_dirty(cmdbuf, VS_PUSH_UNIFORMS);
-      /* Same predicate as the compute loop. panvk_cmd_draw does not see it:
-       * this draw is not PATCHES, and skipping the whole loop would leave
-       * the compute side waiting on the free sync.
+      /* The draw launches are predicated by conditional rendering themselves.
+       * Only they may be skipped: the state emission in front of them runs
+       * once per record, and the loop must still hand the arenas back.
        */
-      {
-         struct cs_index pred = gpu_prerast_load_flag(vt, pass_mem.gpu);
-
-         cs_if(vt, MALI_CS_CONDITION_NEQUAL, pred) {
-            if (nested)
-               gpu_prerast_draw_generated(cmdbuf, &raster, prerast_arena,
-                                          poly_mode, vp_launch);
-            else
-               panvk_cmd_draw(cmdbuf, raster);
-         }
-      }
+      if (nested)
+         gpu_prerast_draw_generated(cmdbuf, &raster, prerast_arena, poly_mode,
+                                    vp_launch);
+      else
+         panvk_cmd_draw(cmdbuf, raster);
       cmdbuf->state.gfx.vs.shader = vs;
       gfx_state_set_dirty(cmdbuf, VS);
       gfx_state_set_dirty(cmdbuf, VS_PUSH_UNIFORMS);
