 // Ensures IPv4 is preferred over IPv6 to avoid potential connection issues
 // See: https://github.com/nodejs/node/issues/40537
 import dns from 'dns';
+import fs from 'fs';
 dns.setDefaultResultOrder('ipv4first');
 
+// Electron's c-ares only reads /etc/resolv.conf, which Termux does not have
+try {
+  const servers = fs
+    .readFileSync('@TERMUX_PREFIX@/etc/resolv.conf', 'utf8')
+    .split('\n')
+    .map((line) => /^\s*nameserver\s+(\S+)/.exec(line)?.[1])
+    .filter((server): server is string => !!server);
+  if (servers.length > 0) {
+    dns.setServers(servers);
+  }
+} catch {
+  // keep the default resolver config
+}
