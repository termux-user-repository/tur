From 3cee73f8db224cff784ba3757a0cf7ce8f46d4a8 Mon Sep 17 00:00:00 2001
From: Pankaj Kumar <pankaj.pal9@gmail.com>
Date: Mon, 19 Oct 2026 10:08:51 +0530
Subject: [PATCH 1/3] fix(irc): reset failedNickServAttempts on Stop and Run

---
 internal/irc/handler.go                |  2 ++
 internal/irc/nickserv_identify_test.go | 10 ++++++++++
 2 files changed, 12 insertions(+)

diff --git a/internal/irc/handler.go b/internal/irc/handler.go
index 3c9e570..aa5d1c7 100644
--- a/internal/irc/handler.go
+++ b/internal/irc/handler.go
@@ -278,6 +278,7 @@ func (h *Handler) Run() (err error) {
 	if h.clientState == ircStopped {
 		shouldConnect = true
 		h.clientState = ircConnecting
+		h.failedNickServAttempts = 0
 	}
 	h.m.Unlock()
 
@@ -607,6 +608,7 @@ func (h *Handler) Stop() {
 	h.m.Lock()
 	h.connectedSince = time.Time{}
 	h.resetFlappingBreakerLocked()
+	h.failedNickServAttempts = 0
 	h.identifyOutstanding = false
 	client := h.client
 	h.clientState = ircStopped
diff --git a/internal/irc/nickserv_identify_test.go b/internal/irc/nickserv_identify_test.go
index 2db47be..5517660 100644
--- a/internal/irc/nickserv_identify_test.go
+++ b/internal/irc/nickserv_identify_test.go
@@ -540,3 +540,13 @@ func TestHandleLoggedIn(t *testing.T) {
 		})
 	}
 }
+
+func TestStopResetsNickServAttempts(t *testing.T) {
+	h, _ := newTestHandler()
+	h.failedNickServAttempts = 3
+	h.Stop()
+
+	h.m.RLock()
+	defer h.m.RUnlock()
+	assert.Equal(t, 0, h.failedNickServAttempts)
+}
