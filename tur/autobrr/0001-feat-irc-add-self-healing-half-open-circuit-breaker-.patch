+	h.m.Lock()
+	h.connectedSince = initial.Add(4 * time.Second)
+	h.m.Unlock()
+	h.onDisconnect(ircmsg.Message{})
+
+	h.m.RLock()
+	staleGen := h.flappingRetryGen
+	h.m.RUnlock()
