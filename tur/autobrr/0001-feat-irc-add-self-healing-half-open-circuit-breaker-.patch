--- a/internal/irc/handler.go
+++ b/internal/irc/handler.go
@@ -69,6 +69,9 @@ const (
 	flappingSessionMinLifetime = 30 * time.Second
 	flappingStopThreshold      = 5
 	flappingWindow             = 15 * time.Minute
