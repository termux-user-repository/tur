diff --git a/internal/irc/flapping_test.go b/internal/irc/flapping_test.go
index dddb6eda..1cd2b443 100644
--- a/internal/irc/flapping_test.go
+++ b/internal/irc/flapping_test.go
@@ -441,3 +441,71 @@ func TestFlappingBreakerStaleTimerCallbackIgnoredAfterStop(t *testing.T) {
 	require.False(t, h.halfOpenAttempt, "stale timer callback must not trigger half-open attempt")
 	require.Equal(t, ircStopped, h.clientState)
 }
+
+func TestFlappingBreakerResumeGracePeriodExcludesSession(t *testing.T) {
+	initial := time.Date(2026, time.October, 19, 12, 0, 0, 0, time.UTC)
+	h, _ := newTestHandler()
+
+	h.OnSystemResume(initial.Add(-20*time.Second), initial.Add(30*time.Second))
+
+	endedAt := initial.Add(10 * time.Second)
+	tripped := recordSessionEnd(h, 5*time.Second, endedAt)
+	require.False(t, tripped, "session during resume grace period should not trip breaker")
+
+	h.m.RLock()
+	defer h.m.RUnlock()
+	require.Empty(t, h.shortSessionEnds, "shortSessionEnds should not record grace-period drops")
+}
+
+func TestResumeProbeTimeoutReconnects(t *testing.T) {
+	h, _ := newTestHandler()
+	h.resumeProbeDelay = time.Millisecond
+	h.resumeProbeTimeout = 20 * time.Millisecond
+
+	reconnected := false
+	h.reconnectFn = func(client *ircevent.Connection) {
+		reconnected = true
+	}
+	h.probePingFn = func(client *ircevent.Connection, token string) error {
+		return nil
+	}
+
+	client := &ircevent.Connection{}
+	h.m.Lock()
+	h.clientState = ircLive
+	h.client = client
+	h.m.Unlock()
+
+	h.probeLiveConnectionAfterResume(client)
+
+	require.True(t, reconnected, "reconnect should be triggered on probe timeout")
+}
+
+func TestResumeProbePongReceivedDoesNotReconnect(t *testing.T) {
+	h, _ := newTestHandler()
+	h.resumeProbeDelay = time.Millisecond
+	h.resumeProbeTimeout = 100 * time.Millisecond
+
+	reconnected := false
+	h.reconnectFn = func(client *ircevent.Connection) {
+		reconnected = true
+	}
+
+	client := &ircevent.Connection{}
+	h.m.Lock()
+	h.clientState = ircLive
+	h.client = client
+	h.m.Unlock()
+
+	h.probePingFn = func(c *ircevent.Connection, token string) error {
+		go func() {
+			time.Sleep(5 * time.Millisecond)
+			client.HandleMessage(ircmsg.MakeMessage(nil, "irc.server.org", "PONG", token))
+		}()
+		return nil
+	}
+
+	h.probeLiveConnectionAfterResume(client)
+
+	require.False(t, reconnected, "reconnect should NOT be triggered when matching PONG is received")
+}
