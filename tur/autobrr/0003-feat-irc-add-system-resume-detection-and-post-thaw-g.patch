 // recordSessionEndLocked records one registered session and reports whether the
 // flapping threshold was reached. The caller must hold h.m.
 func (h *Handler) recordSessionEndLocked(lifetime time.Duration, endedAt time.Time) bool {
+	if !h.excludeFlappingUntil.IsZero() && endedAt.Before(h.excludeFlappingUntil) {
+		h.log.Debug().Time("ended_at", endedAt).Time("exclude_until", h.excludeFlappingUntil).Msg("session end excluded from flapping breaker due to resume grace period")
+		return false
+	}
+
 	if lifetime >= flappingSessionMinLifetime {
 		h.resetFlappingBreakerLocked()
 		return false
@@ -952,6 +963,93 @@ func (h *Handler) clearConnectErrorLocked(substr string) {
 	h.connectionErrors = filtered
 }
 
+func (h *Handler) OnSystemResume(freezeStart, excludeUntil time.Time) {
+	h.m.Lock()
+	h.excludeFlappingUntil = excludeUntil
+	client := h.client
+	isLive := h.clientState == ircLive
+	h.m.Unlock()
+
+	h.log.Info().
+		Time("freeze_start", freezeStart).
+		Time("exclude_until", excludeUntil).
+		Msg("handling system resume; session drops during grace period will be excluded from flapping")
+
+	if isLive && client != nil {
+		go h.probeLiveConnectionAfterResume(client)
+	}
+}
+
+func (h *Handler) probeLiveConnectionAfterResume(client *ircevent.Connection) {
+	delay := 2 * time.Second
+	if h.resumeProbeDelay > 0 {
+		delay = h.resumeProbeDelay
+	}
+	time.Sleep(delay)
+
+	h.m.RLock()
+	stillSameClient := h.client == client && h.clientState == ircLive
+	h.m.RUnlock()
+	if !stillSameClient {
+		return
+	}
+
+	reconnect := func() {
+		h.m.RLock()
+		same := h.client == client && h.clientState == ircLive
+		h.m.RUnlock()
+		if same {
+			if h.reconnectFn != nil {
+				h.reconnectFn(client)
+			} else {
+				client.Reconnect()
+			}
+		}
+	}
+
+	probeToken := fmt.Sprintf("autobrr-probe-%d", time.Now().UnixNano())
+	pongReceived := make(chan struct{}, 1)
+
+	cbID := client.AddCallback("PONG", func(e ircmsg.Message) {
+		for _, p := range e.Params {
+			if p == probeToken {
+				select {
+				case pongReceived <- struct{}{}:
+				default:
+				}
+				return
+			}
+		}
+	})
+	defer client.RemoveCallback(cbID)
+
+	var pingErr error
+	if h.probePingFn != nil {
+		pingErr = h.probePingFn(client, probeToken)
+	} else {
+		pingErr = client.Send("PING", probeToken)
+	}
+
+	if pingErr != nil {
+		h.log.Warn().Err(pingErr).Msg("resume socket probe failed to queue PING; reconnecting dead socket")
+		reconnect()
+		return
+	}
+
+	timeout := 10 * time.Second
+	if h.resumeProbeTimeout > 0 {
+		timeout = h.resumeProbeTimeout
+	}
+
+	select {
+	case <-pongReceived:
+		h.log.Debug().Str("network", h.network.Name).Msg("resume socket probe succeeded; connection is alive")
+	case <-time.After(timeout):
+		h.log.Warn().Str("network", h.network.Name).Msg("resume socket probe timed out waiting for PONG; reconnecting dead socket")
+		reconnect()
+	}
+}
