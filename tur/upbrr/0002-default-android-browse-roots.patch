+func defaultAndroidBrowseRoots() []string {
+	var candidates []string
+	if home := os.Getenv("HOME"); home != "" {
+		candidates = append(candidates, home)
+	}
+	candidates = append(candidates, "/sdcard", "/storage/emulated/0")
+	if entries, err := os.ReadDir("/storage"); err == nil {
+		for _, e := range entries {
+			if e.IsDir() && e.Name() != "self" && e.Name() != "emulated" {
+				candidates = append(candidates, filepath.Join("/storage", e.Name()))
+			}
+		}
+	}
+	seen := make(map[string]bool)
+	var roots []string
+	for _, c := range candidates {
+		resolved, err := filepath.EvalSymlinks(c)
+		if err != nil {
+			resolved = c
+		}
+		clean := filepath.Clean(resolved)
+		if seen[clean] {
+			continue
+		}
+		if _, err := os.ReadDir(clean); err == nil {
+			seen[clean] = true
+			roots = append(roots, clean)
+		}
+	}
+	return roots
+}
