Description: Disable QNetworkInformation on Android/Termux to prevent false offline status
 On Android/Termux, NetworkManager and ConnMan daemons are not running, causing
 QNetworkInformation in Qt6 to falsely report no connectivity and block online
 features (aircraft browser, scenery download, multiplayer). Fall back to
 assuming online connectivity as was done in Qt5.
Author: Fervi (IntinteDAO) <lordfervi@protonmail.com>

--- a/src/GUI/QtLauncher.cxx
+++ b/src/GUI/QtLauncher.cxx
@@ -43,7 +43,7 @@
 #include <QUrl>
 #include <QtGlobal>
 
-#if (QT_VERSION >= QT_VERSION_CHECK(6, 1, 0))
+#if (QT_VERSION >= QT_VERSION_CHECK(6, 1, 0)) && !defined(__ANDROID__)
 #include <QNetworkInformation>
 #endif
 
@@ -489,9 +489,9 @@
 #endif
     }
 
-#if (QT_VERSION >= QT_VERSION_CHECK(6, 3, 0))
+#if (QT_VERSION >= QT_VERSION_CHECK(6, 3, 0)) && !defined(__ANDROID__)
     QNetworkInformation::loadDefaultBackend();
-#elif (QT_VERSION >= QT_VERSION_CHECK(6,1,0))
+#elif (QT_VERSION >= QT_VERSION_CHECK(6,1,0)) && !defined(__ANDROID__)
     bool ok = QNetworkInformation::load(QNetworkInformation::Feature::Reachability);
     if (!ok) {
         qInfo() << "network information plugins:" << QNetworkInformation::availableBackends();
